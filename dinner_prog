([Recipe] tableTracker(name) :
    ([Refrigerate] first; TRUE)
    ([Refrigerate] total; "")

    ([Recipe] order(food) :
        ([Excrete] ([Cook] "Table "; ([Cook] name; ([Cook] " ordering "; food))))
        ([Nausea] (first)
            [Hurl]
                ([Refrigerate] first; FALSE)
                ([Refrigerate] total; food)
            [recover]
                ([Refrigerate] total; ([Cook] total; ([Cook] ", "; food)))
        )
        ([Present] total)
    )
    ([Present] order)
)


([Recipe] stringEq(s1; s2) :
    ([Present] !(([Compare] s1; s2) ^ ([Compare] s2; s1)))
)


