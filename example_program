f Turkey(yesno){
    carve (yesno){
        bawk "Eat da Turkey" bawk
    }
    carve (!yesno){
        bawk "WOMP" bawk
    }
}

bawk "Input True or False" bawk
name -> stuffing < "U"<- name
Turkey(name)

name2 -> stuffing < "U" <- name2
Turkey(name2)
