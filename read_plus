>< read and plus program in Hibana ><

bloom [Enter a filename]
seed fname, harvest
seed contents, read(fname)

seed acount, [0]
seed pow, [1]

>< this loop iteratively chops off the front of the file contents up to the first A ><
seed prefix, contents.chop.[A]
kindle prefix < contents
    seed contents, ((contents.revr + [$$$]).chop.([A] + prefix.revr + [$$$])).revr
    seed acount, plus(acount, [1])
    seed pow, plus(pow, pow)
    seed prefix, contents.chop.[A]
snuff

bloom [File '] + fname + [' has ] + acount + [ As]
bloom [2^] + acount + [ = ] + pow
